# ==============================================================================
# Spaceborne Rapid Disaster Assessment Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your LLM API keys.
# Multiple comma-separated keys per provider are supported for automatic failover
# and rate-limit mitigation.
#
# DO NOT COMMIT THE REAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Groq Cloud API Keys (gsk_...) - Primary fast inference provider
GROQ_API_KEYS=gsk_your_groq_key_1,gsk_your_groq_key_2

# Google Gemini API Keys (AIza... / AQ...) - Multi-lingual & multimodal provider
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# OpenRouter API Keys (sk-or-...) - Fallback provider
OPENROUTER_API_KEYS=sk-or-v1-your_openrouter_key

# Optional: Host and Port for Dashboard Server
HOST=127.0.0.1
PORT=8000
